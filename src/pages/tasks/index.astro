---
import TaskBrowser from "../../components/TaskBrowser.jsx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedTaskCount, taskEntries } from "../../lib/tasks.js";

const taskItems = taskEntries.map((entry) => entry.listItem).reverse();
---

<BaseLayout title="Store">
  <section class="section store-index">
    <div class="section-head"><div><p class="eyebrow">Published catalog</p><h1>{publishedTaskCount} AgentArk task mods</h1><p>Filter by format and task family, then open a listing for platform-specific downloads and task context.</p></div></div>
    <TaskBrowser client:load tasks={taskItems} basePath={import.meta.env.BASE_URL.replace(/\/$/, "")} pageSize={18} />
  </section>
</BaseLayout>
