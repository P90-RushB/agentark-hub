---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { downloadsForTask, getTaskBySlug, hfDatasetUrl, kaggleBenchUrl, taskEntries } from "../../lib/tasks.js";
import { formatBytes, withBase } from "../../lib/site.js";

export function getStaticPaths() {
  return taskEntries.map((entry) => ({ params: { slug: entry.slug } }));
}

const task = getTaskBySlug(Astro.params.slug);
const Content = task.Content;
const downloads = downloadsForTask(task.data.taskId);
const videoId = task.data.videoUrl.match(/\/video\/(BV[0-9A-Za-z]{10})(?:\/|$)/)?.[1];
const videoEmbedUrl = videoId
  ? `https://player.bilibili.com/player.html?isOutside=true&bvid=${videoId}&p=1&autoplay=0`
  : "";
---

<BaseLayout title={task.data.title} description={task.data.summary}>
  <section class="task-hero">
    <div class="task-hero-media">
      {task.data.cover ? <img alt="" src={withBase(task.data.cover)} /> : <div class="fallback-cover"><span>Task {task.artifact.task_id}</span><strong>{task.data.title}</strong></div>}
    </div>
    <div class="task-hero-copy">
      <div class="pill-row"><span class="pill">Task {task.artifact.task_id}</span><span class="pill">{task.data.dimension.toUpperCase()}</span>{task.data.tags.slice(0, 3).map((tag) => <span class="pill">{tag}</span>)}</div>
      <h1>{task.data.title}</h1><p class="lead">{task.data.summary}</p>
      <div class="button-row">{downloads.map((download, index) => <a class={`button ${index === 0 ? "primary" : ""}`} href={download.url}>Download {download.label}</a>)}</div>
    </div>
  </section>

  <section class="section"><div class="detail-grid">
    <div class="task-content">
      {task.data.videoUrl && <section class="video-card task-introduction" aria-labelledby="task-introduction-heading">
        {videoEmbedUrl && <div class="video-frame"><iframe src={videoEmbedUrl} title={`${task.data.title} task introduction`} loading="lazy" scrolling="no" frameborder="0" allow="fullscreen; picture-in-picture" allowfullscreen></iframe></div>}
        <div class="video-card-copy"><p>Task {task.artifact.task_id} · Video guide</p><h2 id="task-introduction-heading">Task introduction</h2><a href={task.data.videoUrl} target="_blank" rel="noopener noreferrer">Open on Bilibili ↗</a></div>
      </section>}
      <article class="detail-panel content-body">{Content ? <Content /> : <><h2>Published task mod</h2><p>This task is available as a public AgentArk Mod. Download a platform archive to run it with a compatible AgentArk environment.</p></>}</article>
    </div>
    <aside>
      <div class="detail-panel"><h2>Task profile</h2><dl><dt>Format</dt><dd>{task.data.dimension.toUpperCase()}</dd><dt>Tags</dt><dd>{task.data.tags.join(", ")}</dd><dt>Version</dt><dd>{task.artifact.task_version} · {task.artifact.env_version}</dd></dl></div>
      <div class="detail-panel"><h2>Public artifacts</h2><p class="muted">Available from <a href={hfDatasetUrl}>P90-RushB/AgentArk</a>.</p><div class="download-list">{downloads.map((download) => <a class="download-link" href={download.url}><strong>{download.label} zip</strong><span>{formatBytes(download.size_bytes)}</span></a>)}</div></div>
      <div class="detail-panel"><h2>Benchmark</h2><p class="muted">Public evaluation results live on Kaggle AgentArk Bench.</p><a class="button" href={kaggleBenchUrl}>Open AgentArk Bench</a></div>
    </aside>
  </div></section>
</BaseLayout>

<style>
  .task-content { display: grid; align-content: start; gap: 18px; min-width: 0; }
  .task-introduction h2 { font-size: 1.35rem; margin-bottom: 14px; }
</style>
